<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.SecondaryController" prefWidth="800" prefHeight="600">
   <top>
      <VBox spacing="6.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Add Courses" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
         </children>
         <padding>
            <Insets top="10" right="10" bottom="10" left="10" />
         </padding>
      </VBox>
   </top>
   <left>
      <GridPane hgap="10" vgap="10" BorderPane.alignment="CENTER">
         <children>
            <Label text="Course Title:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <TextField fx:id="course_title" promptText="Course Name" GridPane.rowIndex="0" GridPane.columnIndex="1" />

            <Label text="Course Code:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <TextField fx:id="course_code" promptText="Course Code" GridPane.rowIndex="1" GridPane.columnIndex="1" />

            <Label text="Teacher 1:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <TextField fx:id="course_teacher1" promptText="Teacher 1" GridPane.rowIndex="2" GridPane.columnIndex="1" />

            <Label text="Teacher 2:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
            <TextField fx:id="course_teacher2" promptText="Teacher 2" GridPane.rowIndex="3" GridPane.columnIndex="1" />

            <Label text="Credit:" GridPane.rowIndex="4" GridPane.columnIndex="0" />
            <ChoiceBox fx:id="course_credit" GridPane.rowIndex="4" GridPane.columnIndex="1" />

            <Label text="Grade:" GridPane.rowIndex="5" GridPane.columnIndex="0" />
            <ChoiceBox fx:id="course_grade" GridPane.rowIndex="5" GridPane.columnIndex="1" />

            <!-- Target total credits removed; only earned/entered credits are shown -->

            <HBox spacing="8" GridPane.rowIndex="7" GridPane.columnIndex="1">
               <children>
                  <Button text="Add Course" onAction="#add_course" fx:id="addButton" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets top="10" left="10" right="10" bottom="10" />
         </padding>
      </GridPane>
   </left>
   <center>
      <VBox spacing="8" BorderPane.alignment="CENTER">
         <children>
            <!-- Course list is kept internal; we don't display taken courses per request -->
            <VBox spacing="6.0">
               <children>
                  <Label fx:id="enteredCreditsLabel" text="Earned Credits: 0.00" />
               </children>
            </VBox>
                
         </children>
         <padding>
            <Insets top="10" left="10" right="10" bottom="10" />
         </padding>
      </VBox>
   </center>
   <bottom>
      <HBox spacing="12" alignment="CENTER_RIGHT" BorderPane.alignment="CENTER">
         <children>
            <Button text="Back to Home" onAction="#switchToPrimary" />
            <Button fx:id="calculateButton" text="Calculate GPA" onAction="#onCalculatePressed" disable="true" />
         </children>
         <padding>
            <Insets top="8" right="10" bottom="8" left="10" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
