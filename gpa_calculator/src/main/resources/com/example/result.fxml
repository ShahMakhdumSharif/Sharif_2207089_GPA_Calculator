<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" alignment="TOP_CENTER" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ResultController">
    <children>
        <Label text="GPA Report">
            <font>
                <Font size="24" />
            </font>
        </Label>
        <Label fx:id="studentSummary" text="" />
        <Separator />
        <VBox fx:id="coursesBox" spacing="6.0" />
        <Separator />
        <HBox spacing="20.0" alignment="CENTER">
            <children>
                <Label fx:id="gpaLabel" text="GPA: -" />
                <Label fx:id="totalCreditsLabel" text="Total Credits: -" />
                <Button text="Back to Home" onAction="#onBackToHome" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>
</VBox>